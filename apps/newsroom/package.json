{
  "name": "newsroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "edition": "tsx --env-file-if-exists=.env --env-file-if-exists=../../packages/db/.env src/cli.ts",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/puzzles": "workspace:*",
    "@repo/shared": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
